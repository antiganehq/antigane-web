# ANT-99 peridot.id domains (ANT-117 frontend).
# All optional — built-in defaults already point at the new domains.
# NEXT_PUBLIC_PERIDOT_ENV=prod|sandbox (default: prod; "sandbox" picks sandbox.* hosts)
# NEXT_PUBLIC_WALLET_URL=https://peridot.id
# NEXT_PUBLIC_API_URL=https://api.peridot.id
# NEXT_PUBLIC_DOCS_URL=https://docs.peridot.id
# NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.peridot.id
